# DrinkIndex — PROD (Oracle Cloud) 환경변수 예시
# 실제 파일명: .env.prod (이 파일을 복사해서 사용, .gitignore 에 포함)
#
# 운영 키는 dev 와 반드시 분리. JWT_SECRET 은 신규 발급.

IMAGE_TAG=latest
SPRING_PROFILES_ACTIVE=prod

# DB
MARIADB_DATABASE=drinkindex_prod
MARIADB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PWD
DB_USERNAME=drinkindex
DB_PASSWORD=CHANGE_ME_STRONG_DB_PWD
PROD_DB_HOST=mariadb

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PWD
PROD_REDIS_HOST=redis

# JWT — 운영 키 (dev 와 절대 공유 금지)
# openssl rand -base64 48
JWT_SECRET=CHANGE_ME_PROD_256BIT_KEY
# 키 회전 중에만 설정. 평소 비어둠.
JWT_SECRET_PREVIOUS=

# Admin
ADMIN_EMAIL=admin@drinkindex.net
ADMIN_PASSWORD=CHANGE_ME_ADMIN_INIT_PWD

# Email
EMAIL_FROM=noreply@drinkindex.net
INQUIRY_EMAIL=admin@drinkindex.net
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Maintenance
MAINTENANCE_MODE=off

# ─── Monitoring (Phase 4a/4c) ───
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PWD
GRAFANA_ROOT_URL=https://grafana.drinkindex.net
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#drinkindex-alerts

# ─── Backup (Phase 4b) ───
BACKUP_DIR=/var/drinkindex/backups
OCI_BUCKET=
