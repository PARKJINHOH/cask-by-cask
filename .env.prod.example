# CaskByCask — PROD (Oracle Cloud) 환경변수 예시
# 실제 파일명: .env.prod (이 파일을 복사해서 사용, .gitignore 에 포함)
#
# 운영 키는 dev 와 반드시 분리. JWT_SECRET 은 신규 발급.
# DB/Redis 는 호스트(Oracle Cloud)에 설치된 것을 사용 — caskbycask_prod 스키마.

IMAGE_TAG=latest
SPRING_PROFILES_ACTIVE=prod

# DB (호스트 MariaDB)
# 같은 서버이면 host.docker.internal, 다른 서버이면 해당 IP/호스트명
PROD_DB_HOST=host.docker.internal
DB_USERNAME=caskbycask
DB_PASSWORD=CHANGE_ME_STRONG_DB_PWD

# Redis (호스트 Redis)
PROD_REDIS_HOST=host.docker.internal
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PWD

# JWT — 운영 키 (dev 와 절대 공유 금지)
# openssl rand -base64 48
JWT_SECRET=CHANGE_ME_PROD_256BIT_KEY
# 키 회전 중에만 설정. 평소 비어둠.
JWT_SECRET_PREVIOUS=

# Admin
ADMIN_EMAIL=admin@caskbycask.net
ADMIN_PASSWORD=CHANGE_ME_ADMIN_INIT_PWD

# Email
EMAIL_FROM=noreply@caskbycask.net
INQUIRY_EMAIL=admin@caskbycask.net
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Maintenance
MAINTENANCE_MODE=off

# ─── Monitoring (Phase 4a/4c) ───
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PWD
GRAFANA_ROOT_URL=https://grafana.caskbycask.net
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#caskbycask-alerts

# ─── Backup (Phase 4b) ───
BACKUP_DIR=/var/caskbycask/backups
OCI_BUCKET=
