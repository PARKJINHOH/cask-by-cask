# Linux 에서 실행되는 파일은 반드시 LF — Windows 에서 커밋해도 CRLF 로 깨지지 않도록.
# (CRLF 면 리눅스 bash 가 $'\r': command not found 등으로 죽음)
*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.template  text eol=lf
gradlew     text eol=lf

# Windows 배치/PS 는 CRLF 유지
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
