# CaskByCask — DEV (Oracle Cloud) 환경변수 예시
# 실제 파일명: .env.dev (이 파일을 복사해서 사용, .gitignore 에 포함)
# DB/Redis 는 호스트(Oracle Cloud)에 설치된 것을 사용 — 컨테이너로 띄우지 않음.

IMAGE_TAG=latest
SPRING_PROFILES_ACTIVE=dev

# DB (호스트 MariaDB)
# 같은 서버이면 host.docker.internal, 다른 서버이면 해당 IP/호스트명
DEV_DB_HOST=host.docker.internal
DB_USERNAME=caskbycask
DB_PASSWORD=CHANGE_ME_STRONG_DB_PWD

# Redis (호스트 Redis)
DEV_REDIS_HOST=host.docker.internal
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PWD

# JWT
# openssl rand -base64 48
JWT_SECRET=CHANGE_ME_BASE64_ENCODED_256BIT_OR_LONGER
JWT_SECRET_PREVIOUS=

# Admin (최초 1회 seed)
ADMIN_EMAIL=admin@caskbycask.net
ADMIN_PASSWORD=CHANGE_ME_ADMIN_INIT_PWD

# Email
EMAIL_FROM=noreply@caskbycask.net
INQUIRY_EMAIL=admin@caskbycask.net
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Maintenance / Misc
MAINTENANCE_MODE=off
