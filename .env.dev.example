# DrinkIndex — DEV (Synology NAS) 환경변수 예시
# 실제 파일명: .env.dev (이 파일을 복사해서 사용, .gitignore 에 포함)

IMAGE_TAG=latest
SPRING_PROFILES_ACTIVE=dev

# DB
MARIADB_DATABASE=drinkindex_dev
MARIADB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PWD
DB_USERNAME=drinkindex
DB_PASSWORD=CHANGE_ME_STRONG_DB_PWD
DEV_DB_HOST=mariadb

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PWD
DEV_REDIS_HOST=redis

# JWT
# openssl rand -base64 48
JWT_SECRET=CHANGE_ME_BASE64_ENCODED_256BIT_OR_LONGER
JWT_SECRET_PREVIOUS=

# Admin (최초 1회 seed)
ADMIN_EMAIL=admin@drinkindex.net
ADMIN_PASSWORD=CHANGE_ME_ADMIN_INIT_PWD

# Email
EMAIL_FROM=noreply@drinkindex.net
INQUIRY_EMAIL=admin@drinkindex.net
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Maintenance / Misc
MAINTENANCE_MODE=off
