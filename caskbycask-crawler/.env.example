# OpenAI (기존 핫딜 분석 파이프라인 전용)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_REQUEST_INTERVAL_SEC=5
# Optional. Leave commented for the official OpenAI API.
# OPENAI_BASE_URL=https://api.openai.com/v1

# AI 소식/팁 검색·작성 (Google AI Studio / Gemini API)
TAVILY_API_KEY=tvly-your-api-key
GEMINI_API_KEY=your-google-ai-studio-api-key
AI_NEWS_CLASSIFIER_MODEL=gemini-3.1-flash-lite
AI_NEWS_WRITER_MODEL=gemini-3.5-flash
AI_NEWS_IMAGE_MODEL=gemini-3.1-flash-lite-image
AI_NEWS_MAX_CANDIDATES_PER_RUN=3
AI_NEWS_SEARCH_RESULTS_PER_QUERY=10
AI_NEWS_LOG_PATH=/app/caskbycask-crawler/logs/ai-news.log
# 관리자 화면 설정과 별개의 최종 안전장치. 0이면 비활성화.
AI_NEWS_GEMINI_HARD_MONTHLY_USD=0
AI_NEWS_GEMINI_HARD_MONTHLY_TOKENS=0
AI_NEWS_GEMINI_HARD_MONTHLY_IMAGES=0
AI_NEWS_FORCE_DRY_RUN=false
# 텍스트 무료 티어 사용 시 true. 유료 결제로 전환하면 false로 바꿔 예상 비용을 집계한다.
AI_NEWS_GEMINI_FREE_TIER=true
# 2026-07-11 Standard 유료 단가. 공급자 가격 변경 시 갱신한다.
AI_NEWS_CLASSIFIER_INPUT_USD_PER_MILLION=0.25
AI_NEWS_CLASSIFIER_OUTPUT_USD_PER_MILLION=1.50
AI_NEWS_WRITER_INPUT_USD_PER_MILLION=1.50
AI_NEWS_WRITER_OUTPUT_USD_PER_MILLION=9.00
# gemini-3.1-flash-lite-image 1K 이미지 1장 예상 비용(이미지는 무료 티어 없음)
AI_NEWS_IMAGE_ESTIMATED_COST_USD=0.0336

# CaskByCask API
# Must match CASKBYCASK_INTERNAL_KEY in the backend api.env.
CASKBYCASK_API_URL=http://127.0.0.1:8080
CASKBYCASK_INTERNAL_KEY=replace-with-same-value-as-backend-api-env

# Runtime paths for Oracle Cloud deployment.
SQLITE_DB_PATH=/app/caskbycask-crawler/seen_posts.db
IMAGE_TEMP_DIR=/app/caskbycask-crawler/temp
LOG_PATH=/app/caskbycask-crawler/logs/crawler.log
TARGETS_PATH=/app/caskbycask-crawler/targets.json

# Naver Cafe authentication cookies.
NAVER_NID_AUT=
NAVER_NID_SES=

# DCInside authentication cookie, if required.
DCINSIDE_COOKIE=

# Slack alerting. Optional; leave blank to disable.
# You can reuse the same webhook as /app/env/api.env.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#server-prd
SLACK_ALERTS_ENABLED=true
SLACK_MAX_ALERTS_PER_RUN=10

# Filtering. Comma-separated values.
DEAL_KEYWORDS=
EXCLUDE_KEYWORDS=
MIN_CONFIDENCE_SCORE=5
ALLOWED_DEAL_CATEGORIES=WHISKY,COGNAC,WINE,TEQUILA,RUM

# Crawling limits.
MAX_IMAGES_PER_POST=3
MAX_NEW_POSTS_PER_RUN=40
SEEN_RETENTION_DAYS=7
MAX_ANALYSIS_RETRIES=2
MAX_AI_ANALYSIS_PER_RUN=40
DUPLICATE_LOOKBACK_HOURS=72
DUPLICATE_JACCARD_THRESHOLD=0.58
DUPLICATE_NGRAM_THRESHOLD=0.62
REQUEST_DELAY_SEC=1.2
HTTP_TIMEOUT_SEC=15

# Start with true to validate analysis without uploading.
# Change to false after confirming crawler output.
DRY_RUN=true
