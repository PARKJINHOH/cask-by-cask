  "panels": [
    {
      "type": "stat",
      "title": "API Up",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"drinkindex-api\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" } }, "type": "value" },
            { "options": { "1": { "text": "UP", "color": "green" } }, "type": "value" }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "MariaDB Up",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "up{job=\"mariadb\"}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Redis Up",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "up{job=\"redis\"}", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Request Rate (req/s)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"drinkindex-api\"}[1m]))", "refId": "A", "legendFormat": "{{uri}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx Error Rate",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"drinkindex-api\",status=~\"5..\"}[5m]))", "refId": "A", "legendFormat": "5xx/s" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency P95 (s)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"drinkindex-api\"}[5m])))", "refId": "A", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"drinkindex-api\"}[5m])))", "refId": "B", "legendFormat": "P99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM Heap Used %",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{job=\"drinkindex-api\",area=\"heap\"}) / sum(jvm_memory_max_bytes{job=\"drinkindex-api\",area=\"heap\"})", "refId": "A", "legendFormat": "heap %" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host CPU Load",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "node_load1", "refId": "A", "legendFormat": "load1" },
        { "expr": "node_load5", "refId": "B", "legendFormat": "load5" },
        { "expr": "node_load15", "refId": "C", "legendFormat": "load15" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host Memory Used %",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "refId": "A", "legendFormat": "mem %" }
      ]
    },
    {
      "type": "timeseries",
      "title": "MariaDB QPS",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        { "expr": "rate(mysql_global_status_queries[1m])", "refId": "A", "legendFormat": "QPS" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Redis Memory",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        { "expr": "redis_memory_used_bytes", "refId": "A", "legendFormat": "used" },
        { "expr": "redis_memory_max_bytes", "refId": "B", "legendFormat": "max" }
      ]
    }
  ],
