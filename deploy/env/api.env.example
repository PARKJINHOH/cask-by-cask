# CaskByCask API (prod) — systemd EnvironmentFile
# 실제 파일: /app/env/api.env  (chmod 600, 배포 유저/실행 유저만 읽기)
#   sudo cp deploy/env/api.env.example /app/env/api.env
#   sudo nano /app/env/api.env       # CHANGE_ME 채우기
#   sudo chown ubuntu:ubuntu /app/env/api.env && sudo chmod 600 /app/env/api.env
#
# ※ 형식: KEY=VALUE (따옴표/공백/export 없이 한 줄에 하나)
# ※ 이 값들은 GitHub 에 절대 올리지 않는다 (서버에서만 관리).

SPRING_PROFILES_ACTIVE=prod

# 앱은 127.0.0.1:8080 에서만 listen (외부는 nginx 만 노출)
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
# management(actuator) 포트/주소는 application-prod.yml 기본값(8081 / 127.0.0.1) 사용

# DB (같은 서버 MariaDB, localhost) — 스키마 caskbycask_prod
DB_HOST=127.0.0.1
DB_USERNAME=caskbycask
DB_PASSWORD=CHANGE_ME_STRONG_DB_PWD

# Redis (같은 서버, localhost)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PWD

# JWT — openssl rand -base64 48 (HS256 최소 32바이트)
JWT_SECRET=CHANGE_ME_BASE64_256BIT_OR_LONGER
JWT_SECRET_PREVIOUS=

# 소셜 로그인(OAuth2) — 네이버·구글
#  - 토큰 암호화 키: Base64 32바이트  →  openssl rand -base64 32
#    (제공자 refresh token 을 암호화 보관, 탈퇴/연동해제 시 연결해지 호출에 사용)
#  - redirect-uri 화이트리스트: 프론트 콜백 URL (콤마 구분). 제공자 콘솔 등록값과 동일해야 함.
#  - client id/secret: 네이버 개발자센터 / 구글 Cloud Console 에서 발급.
OAUTH_TOKEN_ENCRYPTION_KEY=CHANGE_ME_BASE64_32BYTE
OAUTH_ALLOWED_REDIRECT_URIS=https://www.caskbycask.net/oauth/callback
OAUTH_NAVER_CLIENT_ID=CHANGE_ME_NAVER_CLIENT_ID
OAUTH_NAVER_CLIENT_SECRET=CHANGE_ME_NAVER_CLIENT_SECRET
OAUTH_GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
OAUTH_GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

# Instagram / Threads 자동 게시
# 1) 아래 앱 정보를 채우고 API를 재시작한다.
# 2) 최고관리자 > SNS 게시 관리 > 공식 계정에서 각 계정을 OAuth로 연결·검증한다.
# 3) 테스트 게시가 정상일 때만 SOCIAL_PUBLISH_ENABLED=true 로 전환한다.
# 토큰 암호화 키는 Base64 32바이트이며 분실·변경 시 기존 공식 계정을 다시 연결해야 한다.
SOCIAL_PUBLISH_ENABLED=false
SOCIAL_PUBLIC_MEDIA_BASE_URL=https://www.caskbycask.net
SOCIAL_OAUTH_REDIRECT_URI=https://www.caskbycask.net/api/admin/social/accounts/oauth/callback
SOCIAL_TOKEN_ENCRYPTION_KEY=CHANGE_ME_BASE64_32BYTE
SOCIAL_HTTP_CONNECT_TIMEOUT=5s
SOCIAL_HTTP_READ_TIMEOUT=20s
SOCIAL_INSTAGRAM_APP_ID=CHANGE_ME_INSTAGRAM_APP_ID
SOCIAL_INSTAGRAM_APP_SECRET=CHANGE_ME_INSTAGRAM_APP_SECRET
SOCIAL_INSTAGRAM_API_BASE_URL=https://graph.instagram.com/v25.0
SOCIAL_INSTAGRAM_TOKEN_API_BASE_URL=https://graph.instagram.com
SOCIAL_THREADS_APP_ID=CHANGE_ME_THREADS_APP_ID
SOCIAL_THREADS_APP_SECRET=CHANGE_ME_THREADS_APP_SECRET
SOCIAL_THREADS_API_BASE_URL=https://graph.threads.net
SOCIAL_THREADS_TOKEN_API_BASE_URL=https://graph.threads.net
# Meta 콘솔 콜백 URL은 SOCIAL-PUBLISHING.md 참고.
# App Secret은 제거·데이터 삭제 signed_request 검증에도 사용되므로 운영값이 반드시 필요하다.

# 최초 관리자 seed
ADMIN_EMAIL=CHANGE_ME@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_INIT_PWD

# Gmail SMTP 앱 비밀번호
GMAIL_APP_PASSWORD=CHANGE_ME_GMAIL_APP_PWD

# 크롤러(caskbycask-crawler) 내부 API 인증 키 — 크롤러 .env 와 동일값
CASKBYCASK_INTERNAL_KEY=CHANGE_ME_INTERNAL_KEY

# 해외·면세 가격 자동 원화 환산
# API 키가 없는 공개 참고 환율이며 00:05/06:05/12:05/18:05(KST)에 갱신한다.
# 장애 시 DB의 마지막 정상 환율을 계속 사용하므로 일반적으로 변경할 필요가 없다.
EXCHANGE_RATE_PROVIDER_URL=https://api.frankfurter.dev
EXCHANGE_RATE_CONNECT_TIMEOUT_MS=3000
EXCHANGE_RATE_READ_TIMEOUT_MS=15000
EXCHANGE_RATE_RETRY_MAX_ATTEMPTS=3
EXCHANGE_RATE_RETRY_INITIAL_BACKOFF_MS=1000

# SEO canonical 및 sitemap/IndexNow 공개 URL. 운영에서는 반드시 www HTTPS 대표 호스트를 유지한다.
SEO_SITE_URL=https://www.caskbycask.net

# IndexNow: 기본 비활성. 8~128자의 a-f/A-F/0-9/- 키를 생성한 뒤 활성화한다.
# 활성화 시 https://www.caskbycask.net/indexnow-key.txt 에 키 확인 파일이 제공된다.
INDEXNOW_ENABLED=false
INDEXNOW_KEY=
# 쉼표로 구분한 통지 대상. 참여 검색엔진끼리 공유하지만 직접 받은 쪽이 반영이 확실하다.
# (구글은 IndexNow 를 사용하지 않으므로 여기 넣을 대상이 없다)
INDEXNOW_ENDPOINTS=https://www.bing.com/indexnow,https://searchadvisor.naver.com/indexnow
# 예전 단일 설정. 값이 있으면 위 목록에 더해 함께 보낸다(중복 주소는 자동으로 한 번만 보낸다).
# 기존 서버의 api.env 에 남아 있어도 무방하므로 굳이 지우지 않아도 된다.
INDEXNOW_ENDPOINT=

# 유튜브 갤러리 — 허락받고 등록한 채널의 새 영상을 공개 RSS 로 따라잡는다.
# Data API 키를 쓰지 않으므로 할당량이 없고, 조회수·재생시간도 수집하지 않는다.
# ※ CRON 값은 Spring 형식(6필드, 맨 앞이 '초')이다. Unix 5필드로 적으면 API 가 기동에 실패한다.
#    시간대는 코드에서 Asia/Seoul 로 고정되어 있다.
# 아래 값은 전부 애플리케이션 기본값과 같으므로, 조정할 필요가 없으면 생략해도 된다.
YOUTUBE_SYNC_CRON=0 25 */3 * * *
YOUTUBE_FEED_CONNECT_TIMEOUT_MS=3000
YOUTUBE_FEED_READ_TIMEOUT_MS=10000
# 삭제·비공개된 영상 자동 숨김 점검. RSS 는 최신 15편만 담아 옛 영상의 생사를 알려 주지 않는다.
# MAX_PER_RUN 은 1회 실행에서 확인할 영상 수 상한이고, DELAY_MS 는 영상 사이 대기다.
# 영상이 늘어도 1회 실행 시간이 길어지지 않도록 오래 확인 안 한 것부터 순번대로 돈다.
YOUTUBE_AVAILABILITY_CRON=0 40 4 * * *
YOUTUBE_AVAILABILITY_MAX_PER_RUN=300
YOUTUBE_AVAILABILITY_DELAY_MS=150

# (선택) Slack 운영 알림 — 비우면 no-op
# 같은 webhook 을 GitHub repo Secret(SLACK_WEBHOOK_URL)에도 등록하면 배포 결과 알림도 받는다.
# 사용처: 앱 ERROR 로그 / DB 백업 / systemd 비정상 종료(notify-systemd.sh) / 리소스 점검(check-resources.sh)
# 크롤러 알림도 같은 webhook 을 caskbycask-crawler/.env 의 SLACK_WEBHOOK_URL 에 넣어 재사용 가능.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#server-prd

# (선택) 리소스 점검 임계값 — check-resources.sh. 미설정 시 기본값 사용.
# DISK_WARN_PCT=85
# DISK_CRIT_PCT=95
# SSL_WARN_DAYS=14
# SSL_CRIT_DAYS=3
# HEALTH_DOMAIN=www.caskbycask.net

# 저장 경로 (배포와 무관한 영속 위치)
UPLOAD_PATH=/app/upload
# API 시작 시 Spirit 전체 Lucene 재색인 스레드 수. 1~16 범위이며 기본값 4를 우선 사용한다.
# 현재 릴리스는 정합성 보호를 위해 시작 재색인을 끄는 설정을 제공하지 않는다.
HIBERNATE_SEARCH_MASS_INDEX_THREADS=4
# 로그: logback 이 ${LOG_PATH}/caskbycask-api.log 에 출력, 매일 자정 롤오버→gzip(archived/), 30일 보관
LOG_PATH=/app/logs

# 운영 스냅샷 기반 개발 DB 갱신 설정 (수동 실행 전용)
# 실행 스크립트: /app/scripts/refresh-dev-db-from-prod.sh
# - SOURCE_DB 기본값은 caskbycask_prod
# - TARGET_DB 기본값은 caskbycask_dev
# - 운영 DB는 dump 전용으로만 읽고, 개발 DB는 백업 후 drop/create 및 민감정보 정리된 데이터로 교체한다.

# 권장: 운영 DB dump 전용 읽기 계정을 별도로 생성한다.
# 비어 있으면 스크립트가 DB_USERNAME / DB_PASSWORD 를 대신 사용한다.
# PROD_DB_READONLY_USERNAME=caskbycask_prod_ro
# PROD_DB_READONLY_PASSWORD=CHANGE_ME_PROD_READONLY_PWD

# 임시 DB와 caskbycask_dev 를 create/drop/restore 할 때 사용하는 계정.
# 비어 있으면 스크립트가 DB_USERNAME / DB_PASSWORD 를 대신 사용한다.
DEV_REFRESH_DB_USERNAME=caskbycask_dev_refresh
DEV_REFRESH_DB_PASSWORD=CHANGE_ME_DEV_REFRESH_PWD

# restore 후 운영 계정 데이터는 제거한다.
# 공개 콘텐츠 작성자는 withdrawn@caskbycask.system 계정으로 재귀속한다.
# 최고관리자는 생성하지 않는다. API 재시작 시 ADMIN_EMAIL / ADMIN_PASSWORD 기반 Spring seed 로직이 생성한다.
# DEV_REFRESH_BACKUP_DIR=/app/db_backup/dev_refresh
# DEV_REFRESH_RETENTION_DAYS=7
