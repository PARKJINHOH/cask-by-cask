# DrinkIndex API (prod) — systemd EnvironmentFile 예시
# 실제 파일: /etc/drinkindex/prod.env  (chmod 600 권장)
#   sudo cp deploy/env/prod.env.example /etc/drinkindex/prod.env
#   sudo nano /etc/drinkindex/prod.env   # CHANGE_ME 채우기
#   sudo chmod 600 /etc/drinkindex/prod.env
#
# Jenkins 사용 시: 이 파일을 Jenkins Credentials(Secret file, ID: drinkindex-prod-env) 로 관리하고
# 배포 단계에서 /etc/drinkindex/prod.env 로 설치.
#
# ※ EnvironmentFile 형식 주의: KEY=VALUE (따옴표/공백/export 없이 한 줄에 하나).
# ※ prod 는 dev 와 같은 서버에서 다른 포트로 동작 → 포트가 dev(8092/8093/8090)와 겹치면 안 됨.

SPRING_PROFILES_ACTIVE=prod

# 네이티브 프로세스 포트 (dev=8092/8093, 기존 컨테이너=8080/8081/30000/30001 회피)
# 이 환경변수가 application-prod.yml 의 management.server.port(8081) 기본값을 덮어쓴다.
SERVER_PORT=8094
SERVER_ADDRESS=127.0.0.1
MANAGEMENT_SERVER_PORT=8095
MANAGEMENT_HOST=127.0.0.1

# DB (호스트 MariaDB — drinkindex_prod 스키마, 네이티브라 localhost)
PROD_DB_HOST=127.0.0.1
DB_USERNAME=drink_index
DB_PASSWORD=CHANGE_ME_STRONG_DB_PWD

# Redis (호스트 Redis)
PROD_REDIS_HOST=127.0.0.1
PROD_REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PWD

# JWT — openssl rand -base64 48 (HS256 최소 32바이트). dev 와 다른 값 사용 권장.
JWT_SECRET=CHANGE_ME_BASE64_ENCODED_256BIT_OR_LONGER
JWT_SECRET_PREVIOUS=

# Admin (최초 1회 seed)
ADMIN_EMAIL=adg0609@naver.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_INIT_PWD

# Email
EMAIL_FROM=drinkindex.cs@gmail.com
INQUIRY_EMAIL=adg0609@naver.com
GMAIL_USERNAME=drinkindex.cs@gmail.com
GMAIL_APP_PASSWORD=CHANGE_ME_GMAIL_APP_PWD

# (선택) Slack 운영 알림 — 비우면 no-op
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#drinkindex-alerts

# 저장소 / 로그 경로 (배포 유저가 쓰기 가능해야 함 — dev 와 분리)
UPLOAD_PATH=/var/drinkindex/uploads
LOG_PATH=/var/drinkindex/logs/prod
