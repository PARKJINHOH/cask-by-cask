# CaskByCask 외부 백업 전용 환경 파일
# 운영 파일: /app/env/backup.env (백업 실행 사용자 소유, chmod 600, Git 저장 금지)
# 배포 아티팩트 버킷과 분리된 private Object Storage 버킷 및 전용 Customer Secret Key를 사용한다.

OCI_BACKUP_ACCESS_KEY_ID=CHANGE_ME_BACKUP_ACCESS_KEY_ID
OCI_BACKUP_SECRET_ACCESS_KEY=CHANGE_ME_BACKUP_SECRET_ACCESS_KEY
OCI_BACKUP_ENDPOINT=https://CHANGE_ME_NAMESPACE.compat.objectstorage.ap-chuncheon-1.oraclecloud.com
OCI_BACKUP_REGION=ap-chuncheon-1
OCI_BACKUP_BUCKET=CHANGE_ME_PRIVATE_BACKUP_BUCKET
OCI_BACKUP_PREFIX=production

# OCI Console/native CLI에서 private bucket, versioning, lifecycle을 확인한 뒤에만 true로 바꾼다.
OCI_BACKUP_VERSIONING_CONFIRMED=false
# 위 bucket/prefix를 사람이 다시 확인하는 값. 예: my-private-backup/production
OCI_BACKUP_TARGET_CONFIRMATION=

# 실제 애플리케이션 영속 경로와 realpath가 정확히 같아야 한다.
LOCAL_DB_BACKUP_DIR=/app/db_backup
UPLOAD_PATH=/app/upload
OFFSITE_DB_SOURCE_CONFIRMED=/app/db_backup
OFFSITE_UPLOAD_SOURCE_CONFIRMED=/app/upload

# /app/upload/.caskbycask-upload-root 파일의 내용은 다음 한 줄이어야 한다.
# caskbycask-upload-root-v1

# 안전한 snapshot/garbage-collection 설계 전까지 스크립트는 원격 삭제를 지원하지 않고 추가·갱신만 한다.

# 로컬 DB 덤프가 이 시간보다 오래되면 외부 백업을 실패 처리한다.
OFFSITE_MAX_DB_AGE_HOURS=26

# 복원 훈련은 운영 서버가 아닌 disposable 격리 호스트의 별도 backup.env에만 아래 값을 설정한다.
# 격리 호스트에서 /etc/machine-id를 확인하고 root가 아닌 제한 계정으로 실행한다.
RESTORE_DRILL_ISOLATION_CONFIRMED=false
RESTORE_DRILL_EXPECTED_MACHINE_ID=
RESTORE_DRILL_TARGET_CAPACITY_CONFIRMED=false
RESTORE_DRILL_WORK_DIR=/var/tmp/caskbycask-restore
RESTORE_DRILL_WORK_DIR_CONFIRMED=/var/tmp/caskbycask-restore
RESTORE_DRILL_DB_HOST=127.0.0.1
RESTORE_DRILL_DB_PORT=3306
RESTORE_DRILL_DB_NAME=caskbycask_restore_drill_validation
RESTORE_DRILL_DB_USERNAME=caskbycask_restore_drill
RESTORE_DRILL_DB_PASSWORD=CHANGE_ME_RESTORE_ONLY_PASSWORD
RESTORE_DRILL_DB_TARGET_CONFIRMATION=
RESTORE_DRILL_MAX_BACKUP_AGE_HOURS=36
RESTORE_DRILL_MIN_LOCAL_FREE_MB=1024
RESTORE_DRILL_IMPORT_TIMEOUT_SECONDS=7200
RESTORE_DRILL_MAX_UPLOAD_SAMPLE_MB=50
RESTORE_DRILL_REQUIRE_UPLOADS=true

# 선택: 외부 백업 성공/실패 알림. 비우면 알림을 보내지 않는다.
BACKUP_SLACK_WEBHOOK_URL=
