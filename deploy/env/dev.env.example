# DrinkIndex API (dev) — systemd EnvironmentFile 예시
# 실제 파일: /etc/drinkindex/dev.env  (root:root, chmod 600 권장)
#   sudo mkdir -p /etc/drinkindex
#   sudo cp deploy/env/dev.env.example /etc/drinkindex/dev.env
#   sudo nano /etc/drinkindex/dev.env   # CHANGE_ME 채우기
#   sudo chmod 600 /etc/drinkindex/dev.env
#
# Jenkins 사용 시: 이 파일을 Jenkins Credentials 로 관리하고 배포 단계에서 생성.
#
# ※ EnvironmentFile 형식 주의: KEY=VALUE (따옴표/공백/export 없이 한 줄에 하나).

SPRING_PROFILES_ACTIVE=dev

# 네이티브 프로세스 포트 (8080/8081 은 기존 컨테이너가 사용 중 → 충돌 회피)
SERVER_PORT=8092
SERVER_ADDRESS=127.0.0.1
MANAGEMENT_SERVER_PORT=8093
MANAGEMENT_HOST=127.0.0.1

# DB (호스트 MariaDB — 네이티브 프로세스라 그냥 localhost)
DEV_DB_HOST=127.0.0.1
DB_USERNAME=drink_index
DB_PASSWORD=CHANGE_ME_STRONG_DB_PWD

# Redis (호스트 Redis)
DEV_REDIS_HOST=127.0.0.1
DEV_REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PWD

# JWT — openssl rand -base64 48 (HS256 최소 32바이트)
JWT_SECRET=CHANGE_ME_BASE64_ENCODED_256BIT_OR_LONGER
JWT_SECRET_PREVIOUS=

# Admin (최초 1회 seed)
ADMIN_EMAIL=adg0609@naver.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_INIT_PWD

# Email
EMAIL_FROM=drinkindex.cs@gmail.com
INQUIRY_EMAIL=adg0609@naver.com
GMAIL_USERNAME=drinkindex.cs@gmail.com
GMAIL_APP_PASSWORD=CHANGE_ME_GMAIL_APP_PWD

# 저장소 / 로그 경로 (ubuntu 가 쓰기 가능해야 함)
UPLOAD_PATH=/var/drinkindex/uploads
LOG_PATH=/var/drinkindex/logs/dev
