// ─────────────────────────────────────────────────────────────────────────────
// DrinkIndex 프론트엔드 배포 파이프라인 (Docker 미사용 / 정적파일)
//
// Jenkins 설정:
//   - Pipeline job → "Pipeline script from SCM" → Script Path: deploy/jenkins/Jenkinsfile.web
//   - SCM path filter 로 drinkindex-web/** 만 트리거 → 작은 FE 수정도 ~수십초로 끝
//   - 시크릿 불필요 (VITE_API_BASE_URL 비움 → 상대경로 /api 사용)
//   - Jenkins 실행 유저가 rsync 대상(/var/www/drinkindex-<env>) 쓰기 가능해야 함
// ─────────────────────────────────────────────────────────────────────────────
pipeline {
    agent any

    parameters {
        choice(name: 'DEPLOY_ENV', choices: ['dev'], description: '배포 환경')
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Build & Deploy') {
            steps {
                sh 'chmod +x deploy/deploy-web.sh && ./deploy/deploy-web.sh ${DEPLOY_ENV}'
            }
        }
    }

    post {
        success { echo '✅ 프론트엔드 배포 성공' }
        failure { echo '❌ 프론트엔드 배포 실패' }
    }
}
