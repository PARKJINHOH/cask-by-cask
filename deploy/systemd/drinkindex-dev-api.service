# DrinkIndex API (dev) — systemd 유닛
# 설치:
#   sudo cp deploy/systemd/drinkindex-dev-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now drinkindex-dev-api
#
# 로그:  journalctl -u drinkindex-dev-api -f
# 상태:  systemctl status drinkindex-dev-api

[Unit]
Description=DrinkIndex API (dev)
After=network-online.target mariadb.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu

# 환경변수 (DB/Redis/JWT/Admin 등) — Jenkins 또는 수동으로 생성
EnvironmentFile=/etc/drinkindex/dev.env

WorkingDirectory=/opt/drinkindex-dev/api
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom -jar /opt/drinkindex-dev/api/app.jar

# bootJar 종료 시그널(SIGTERM) 정상 종료 코드
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

# 간단한 보안 하드닝
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
