# CaskByCask API (prod) — systemd 유닛 (단일 환경 / /app 구조)
# 설치:
#   sudo cp deploy/systemd/caskbycask-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now caskbycask-api
#
# 로그:  journalctl -u caskbycask-api -f
# 상태:  systemctl status caskbycask-api

[Unit]
Description=CaskByCask API (prod)
After=network-online.target mariadb.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu

# 앱 환경변수 (DB/Redis/JWT/Admin 등) — git/GitHub 에 없고 서버에만 존재 (chmod 600)
EnvironmentFile=/app/env/api.env

WorkingDirectory=/app/spring-boot
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=70.0 -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom -jar /app/spring-boot/app.jar

# Slack 알림 훅 — 기동 시 / 비정상 종료 시. (정상 stop/restart 는 SERVICE_RESULT=success 라 무알림)
# (-) 접두: 알림 스크립트가 실패해도 서비스 상태에는 영향 주지 않음
ExecStartPost=-/app/scripts/notify-systemd.sh start
ExecStopPost=-/app/scripts/notify-systemd.sh stop

# bootJar 종료 시그널(SIGTERM) 정상 종료 코드
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

# 보안 하드닝
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/app/upload /app/logs /app/spring-boot

[Install]
WantedBy=multi-user.target
